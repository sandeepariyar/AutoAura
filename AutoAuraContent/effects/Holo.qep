{
    "QEP": {
        "fragmentCode": [
            "void main() {",
            "    fragColor = texture(iSource, texCoord);",
            "    @nodes",
            "    fragColor = fragColor * qt_Opacity;",
            "}",
            ""
        ],
        "nodes": [
            {
                "custom": false,
                "description": "The effect is similar to what happens when a colorized glass is put on top of a grayscale image. The color for the overlay is given in the RGBA format.",
                "enabled": true,
                "fragmentCode": [
                    "// Ring Effect for QDS Effect Composer",
                    "// Optimized for low-end devices",
                    "",
                    "vec3 hash33(vec3 p3)",
                    "{",
                    "    p3 = fract(p3 * vec3(.1031, .11369, .13787));",
                    "    p3 += dot(p3, p3.yxz + 19.19);",
                    "    return -1.0 + 2.0 * fract(vec3(p3.x + p3.y, p3.x + p3.z, p3.y + p3.z) * p3.zyx);",
                    "}",
                    "",
                    "float snoise2(vec2 p)",
                    "{",
                    "    vec2 i = floor(p);",
                    "    vec2 f = fract(p);",
                    "    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0); // Smoother interpolation",
                    "    ",
                    "    float a = dot(hash33(vec3(i + vec2(0.0, 0.0), 0.0)).xy, f - vec2(0.0, 0.0));",
                    "    float b = dot(hash33(vec3(i + vec2(1.0, 0.0), 0.0)).xy, f - vec2(1.0, 0.0));",
                    "    float c = dot(hash33(vec3(i + vec2(0.0, 1.0), 0.0)).xy, f - vec2(0.0, 1.0));",
                    "    float d = dot(hash33(vec3(i + vec2(1.0, 1.0), 0.0)).xy, f - vec2(1.0, 1.0));",
                    "    ",
                    "    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);",
                    "}",
                    "",
                    "float light1(float intensity, float attenuation, float dist)",
                    "{",
                    "    return intensity / (1.0 + dist * attenuation);",
                    "}",
                    "",
                    "float light2(float intensity, float attenuation, float dist)",
                    "{",
                    "    return intensity / (1.0 + dist * dist * attenuation);",
                    "}",
                    "",
                    "@main",
                    "{",
                    "    // Center and scale UV to -1 to 1 range",
                    "    vec2 uv = (fragCoord / iResolution.xy) * 2.0 - 1.0;",
                    "    ",
                    "    // Ring parameters - adjusted for size",
                    "    float innerRadius = 0.25;",
                    "    float outerRadius = 0.45;",
                    "    float noiseScale = 2.0;",
                    "    float pulseSpeed = 0.5;",
                    "    ",
                    "    // Colors",
                    "    vec3 color1 = vec3(0.8, 0.2, 1.0);  // Purple",
                    "    vec3 color2 = vec3(0.3, 0.9, 1.0);  // Cyan",
                    "    vec3 color3 = vec3(0.1, 0.1, 0.8);  // Deep blue",
                    "    vec3 color4 = vec3(1.0, 0.5, 0.0);  // Orange accent",
                    "    ",
                    "    float ang = atan(uv.y, uv.x);",
                    "    float len = length(uv);",
                    "    ",
                    "    // Noise for organic movement",
                    "    float n0 = snoise2(uv * noiseScale + vec2(iTime * 0.2, 0.0)) * 0.5 + 0.5;",
                    "    float r0 = mix(innerRadius, outerRadius, n0 * 0.5);",
                    "    float d0 = abs(len - r0);",
                    "    ",
                    "    // Main ring glow",
                    "    float v0 = light1(1.0, 15.0, d0);",
                    "    v0 *= smoothstep(outerRadius + 0.1, r0, len);",
                    "    ",
                    "    // Color rotation",
                    "    float cl = cos(ang + iTime) * 0.5 + 0.5;",
                    "    ",
                    "    // Pulse effect",
                    "    float pulse = sin(iTime * pulseSpeed) * 0.15 + 0.85;",
                    "    v0 *= pulse;",
                    "    ",
                    "    // Orbiting light",
                    "    float a = iTime * -1.0;",
                    "    vec2 pos = vec2(cos(a), sin(a)) * r0;",
                    "    float d = distance(uv, pos);",
                    "    float v1 = light2(1.5, 8.0, d) * light1(1.0, 50.0, d0);",
                    "    ",
                    "    // Smooth edges",
                    "    float v2 = smoothstep(outerRadius + 0.15, innerRadius + n0 * 0.2, len);",
                    "    float v3 = smoothstep(innerRadius - 0.05, innerRadius + 0.3, len);",
                    "    ",
                    "    // Mix colors",
                    "    vec3 col = mix(color3, mix(color1, color2, cl), v0);",
                    "    col += v1 * color4 * 0.6;",
                    "    col *= v2 * v3;",
                    "    ",
                    "    // Smooth alpha falloff",
                    "    float alpha = smoothstep(0.0, 0.1, v0 * v2 * v3) * (v0 + v1 * 0.5);",
                    "    alpha = clamp(alpha, 0.0, 1.0);",
                    "    ",
                    "    col = clamp(col, 0.0, 1.0);",
                    "    ",
                    "    fragColor = vec4(col, alpha);",
                    "}",
                    ""
                ],
                "id": "color_overlay",
                "name": "Color Overlay",
                "version": 1
            }
        ],
        "previewColor": "#dddddd",
        "previewImage": "images/preview0.png",
        "tool": "EffectComposer",
        "version": 1,
        "vertexCode": [
            "void main() {",
            "    texCoord = qt_MultiTexCoord0;",
            "    fragCoord = qt_Vertex.xy;",
            "    vec2 vertCoord = qt_Vertex.xy;",
            "    @nodes",
            "    gl_Position = qt_Matrix * vec4(vertCoord, 0.0, 1.0);",
            "}",
            ""
        ]
    }
}
